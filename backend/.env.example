# ── EHR AI Sidebar — Environment Variables ────────────────────────────────────
# Copy this file to .env and fill in your values.
#   cp .env.example .env

# ── Anthropic Claude (fallback LLM + Claude Vision fallback) ─────────────────
# Get yours at: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# ── HuggingFace (required for gated models) ──────────────────────────────────
# Get yours at: https://huggingface.co/settings/tokens
# Needed for:
#   - epfl-llm/meditron-7b       (request access at https://hf.co/epfl-llm/meditron-7b)
#   - wanglab/ClinicalCamel-70B  (request access at https://hf.co/wanglab/ClinicalCamel-70B)
# Not needed for: BioMistral-7B, PMC-LLaMA-13B, LLaVA, Qwen2-VL, InternVL2
HF_TOKEN=

# ── Security ──────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-in-production

# ── Document encryption (HIPAA) ───────────────────────────────────────────────
# Generate with: python -c "import secrets,base64; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
EHR_ENCRYPTION_KEY=
ENCRYPT_UPLOADS=true

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./ehr_ai.db

# ── Ollama (local LLM server) ─────────────────────────────────────────────────
# Install Ollama: https://ollama.ai
# Pull a model:  ollama pull llama3.2
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_DEFAULT_MODEL=llama3.2

# ── Redis (task queue for fine-tuning jobs) ───────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Vision pipeline ───────────────────────────────────────────────────────────
# Confidence threshold below which the vision cascade fires (0.0–1.0)
VISION_CASCADE_THRESHOLD=0.40

# ── Debug ─────────────────────────────────────────────────────────────────────
DEBUG=false
