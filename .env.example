# ── Anthropic Claude ──────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-your-key-here

# ── HuggingFace (for downloading gated models like Llama 3) ──────────────────
HF_TOKEN=hf_your_token_here

# ── Ollama (local LLM serving) ────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434

# ── App ───────────────────────────────────────────────────────────────────────
DEBUG=false
SECRET_KEY=change-this-to-a-random-secret-in-production

# ── HIPAA Security (required in production) ───────────────────────────────────
# API key — protects all PHI endpoints (X-API-Key header)
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
EHR_API_KEY=

# AES-256-GCM master key for encrypting documents at rest
# Generate: python -c "import secrets,base64; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
EHR_ENCRYPTION_KEY=
ENCRYPT_UPLOADS=true

# HIPAA audit log path (append-only, tamper-evident hash chain)
AUDIT_LOG_PATH=./audit.jsonl

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./ehr_ai.db
REDIS_URL=redis://localhost:6379/0

# ── Storage ───────────────────────────────────────────────────────────────────
UPLOAD_DIR=./uploads
MODELS_DIR=./models
DATASETS_DIR=./datasets

# ── OCR ───────────────────────────────────────────────────────────────────────
# TESSERACT_PATH=/usr/bin/tesseract  # only needed if not in PATH
